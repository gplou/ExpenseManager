<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: excluye TODOS los datos de la app tanto del backup en la nube
     como de la transferencia directa entre dispositivos (que ignora
     android:allowBackup). Ver el comentario de <application> en el manifest. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
