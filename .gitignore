# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit real values
dart_defines.json
dart_defines_e2e.json
.env.sentry
android/key.properties
android/app/upload-keystore.jks

# OAuth client secrets (downloaded from Google Cloud Console)
/android/app/*.json

# FVM Version Cache
.fvm/

# Claude Code local state
.claude/scheduled_tasks.lock
.claude/worktrees/
# Imágenes — solo en local, nunca al repositorio
# (capturas de tienda, exports, pruebas visuales…)
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.heic
*.heif
*.tiff
*.psd
*.ico
*.svg

# Excepciones: assets que la app necesita para compilar
!assets/images/**
!android/app/src/main/res/**
!ios/Runner/Assets.xcassets/**
